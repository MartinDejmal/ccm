{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["DOM", "ES2022", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true
    },
    "include": ["resources/js"]
}
