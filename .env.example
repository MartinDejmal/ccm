APP_NAME=CCM
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=cs
LOG_CHANNEL=stderr
DB_CONNECTION=mariadb
# Percent-encode special characters in the username/password URL components.
DB_URL="mysql://ccm:CHANGE_ME@host.docker.internal:3306/ccm?charset=utf8mb4"
DB_COLLATION=utf8mb4_unicode_ci
# Optional CA path inside the container; mount your CA read-only if needed.
# MYSQL_ATTR_SSL_CA=/run/secrets/database-ca.pem
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Set to the trusted reverse proxy IP/CIDR(s), comma-separated.
# Use * only when the app port is exclusively reachable by your proxy.
TRUSTED_PROXIES=
